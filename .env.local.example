ANTHROPIC_API_KEY=your-anthropic-key-here
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# SADECE SUNUCUDA kullanılır (app/api/send-otp), asla NEXT_PUBLIC_ yapma —
# tarayıcıya çıkarsa RLS'i tamamen atlayan bir anahtar sızmış olur.
# Supabase Dashboard -> Project Settings -> API -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Telefon SMS doğrulama (Netgsm) — bunlar boşken /api/send-otp "configured: false"
# döner ve doğrulama adımı otomatik olarak yumuşak (atlanabilir) kalır.
# Netgsm hesabı açıp API alt kullanıcısı oluşturunca doldur.
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=
